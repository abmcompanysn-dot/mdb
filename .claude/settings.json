{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash(make:*)",
      "Bash(go:*)",
      "Bash(gofmt:*)",
      "Bash(sqlc:*)",
      "Bash(goose:*)",
      "Bash(pnpm:*)",
      "Bash(npx playwright:*)",
      "Bash(docker compose:*)",
      "Bash(docker build:*)",
      "Bash(docker push registry.local:5000/*)",
      "Bash(kubectl:*)",
      "Bash(kubeconform:*)",
      "Bash(kustomize:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Read(./secrets/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./boucle.sh)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git filter-branch:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(kubectl * -n prod*)",
      "Bash(kubectl * --namespace prod*)",
      "Bash(kubectl config:*)",
      "Read(~/.kube/**)",
      "Read(./node_modules/**)",
      "Read(./**/node_modules/**)",
      "Read(./**/.next/**)",
      "Read(./logs/**)",
      "Read(./data/**)"
    ]
  }
}