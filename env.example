# =====================================================================
# Copier ce fichier en .env (jamais envoyé sur GitHub) et remplir les valeurs.
# Uniquement des clés de TEST / SANDBOX. Jamais de clés de production ici.
# Une valeur vide = le service fonctionne en mode simulé.
# =====================================================================

# --- Application -------------------------------------------------------
APP_NAME=Plateforme
APP_DOMAIN=localhost
APP_ENV=development
# Générer avec : openssl rand -hex 32
SESSION_SECRET=
ENCRYPTION_KEY=

# --- Services locaux (déjà fournis par docker-compose) ------------------
DATABASE_URL=postgres://plateforme:plateforme@localhost:5432/plateforme?sslmode=disable
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

# --- Kubernetes (k3s du VPS) -------------------------------------------
# kubeconfig du compte de service limité aux namespaces dev et staging
KUBECONFIG=/home/claude/.kube/boucle.yaml
REGISTRY=registry.local:5000
# Jeton DNS Cloudflare pour les certificats joker (cert-manager)
CLOUDFLARE_DNS_API_TOKEN=

# --- Ton serveur Kafka de test (laisser vide pour utiliser Redpanda local)
KAFKA_TEST_BROKERS=
KAFKA_TEST_USERNAME=
KAFKA_TEST_PASSWORD=
KAFKA_TEST_CA_CERT_PATH=

# --- Paiement mobile : agrégateur local (mode test / sandbox) -----------
# Wave, Orange Money, Free Money via l'agrégateur choisi (PayDunya, CinetPay...)
PAYMENT_AGGREGATOR=
PAYMENT_AGGREGATOR_MODE=test
PAYMENT_AGGREGATOR_PUBLIC_KEY=
PAYMENT_AGGREGATOR_PRIVATE_KEY=
PAYMENT_AGGREGATOR_WEBHOOK_SECRET=

# --- Carte bancaire : Stripe (clés commençant par sk_test_ / pk_test_) --
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Emails (vide = Mailpit local) --------------------------------------
EMAIL_FROM=
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# --- Fichiers : Cloudflare R2 (vide = dossier local) --------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Meta (Facebook / Instagram) : application en mode développement ---
META_APP_ID=
META_APP_SECRET=
META_TEST_EVENT_CODE=

# --- Suivi des erreurs ---------------------------------------------------
SENTRY_DSN=
